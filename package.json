{
  "name": "developer-portfolio",
  "version": "1.28.5",
  "description": "Developer's portfolio showcasing projects, experience and certification in a visually appealing manner",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/portfolio-shirsendu.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.11.0 || ^24.14.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0",
    "bun": "^1.2.9"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:load": "k6 run tests/load.test.ts",
    "build": "nuxt build && (cp -r static .output/static || true)",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file=.env.prod .output/server/index.mjs",
    "clean": "nuxt cleanup && (cd src-tauri && cargo clean)",
    "docker:build": "docker build --build-arg VERSION=dev -t developer-portfolio:dev .",
    "docker:start": "docker run --detach --name developer-portfolio-dev --mount type=bind,source=$(pwd)/static,target=/app/static,readonly --env-file .env.prod -p 4100:3000 developer-portfolio:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:mobile": "tauri android dev",
    "tauri:build:mobile": "tauri android build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.36.0",
    "@hannoeru/nuxt-otel": "^0.0.8",
    "@notionhq/client": "^5.27.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mcp-toolkit": "^0.24.2",
    "@nuxtjs/seo": "^6.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@regle/nuxt": "^1.29.5",
    "@splidejs/splide-extension-grid": "^0.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@types/web-push": "^3.6.4",
    "@unhead/vue": "^3.4.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "confbox": "^0.3.1",
    "date-fns": "^4.4.0",
    "nuxt": "^4.6.1",
    "nuxt-splide": "^1.1.2",
    "vue": "latest",
    "vue-router": "latest",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/bun": "^1.4.3",
    "@types/k6": "^2.3.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "isolated-vm",
    "protobufjs",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ]
}